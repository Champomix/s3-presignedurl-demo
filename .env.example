# === RustFS / Storage ===
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
S3_BUCKET=demo-bucket
S3_REGION=us-east-1

# === Kafka (optionnel : docker compose -f docker-compose.yml -f docker-compose.kafka.yml up) ===
KAFKA_BROKERS=kafka.example.lan:9093
KAFKA_TOPIC=s3-events
KAFKA_SASL_USERNAME=rustfs
KAFKA_SASL_PASSWORD=changeme
# Certificat CA (ou auto-signe) du broker, monte dans RustFS
KAFKA_CA_FILE=./storage/kafka-ca.pem

# === Backend ===
PORT=3001
PRESIGN_EXPIRES_DEFAULT=300
# 100 Mo
MAX_UPLOAD_SIZE=104857600
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# === MinIO HTTPS (certificat auto-signé) ===
MINIO_TLS_ENDPOINT=https://minio.example.lan:9000
MINIO_TLS_REGION=us-east-1
MINIO_TLS_BUCKET=demo-bucket
MINIO_TLS_ACCESS_KEY=minioadmin
MINIO_TLS_SECRET_KEY=minioadmin

# === Proxy pour npm install / npm ci pendant le build Docker (laisser vide si aucun) ===
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
