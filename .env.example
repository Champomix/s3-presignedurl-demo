# === RustFS / Storage ===
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
S3_BUCKET=demo-bucket
S3_REGION=us-east-1

# === Kafka distant (optionnel : -f docker-compose.kafka.yml) ===
# KAFKA_TOPIC sert aussi au Kafka local (-f docker-compose.kafka-local.yml)
KAFKA_BROKERS=kafka.example.lan:9093
KAFKA_TOPIC=s3-events
KAFKA_SASL_USERNAME=rustfs
KAFKA_SASL_PASSWORD=changeme
# Certificat CA (ou auto-signe) du broker, monte dans RustFS
KAFKA_CA_FILE=./storage/kafka-ca.pem

# === Console Conduktor (optionnel : -f docker-compose.conduktor.yml, avec le Kafka local) ===
CONDUKTOR_ADMIN_EMAIL=admin@demo.local
CONDUKTOR_ADMIN_PASSWORD=Admin1234!

# === Monitoring (optionnel : docker compose -f docker-compose.yml -f docker-compose.monitoring.yml up) ===
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# === Backend ===
PORT=3001
PRESIGN_EXPIRES_DEFAULT=300
# 100 Mo
MAX_UPLOAD_SIZE=104857600
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# === MinIO HTTPS (certificat auto-signé) ===
MINIO_TLS_ENDPOINT=https://minio.example.lan:9000
MINIO_TLS_REGION=us-east-1
MINIO_TLS_BUCKET=demo-bucket
MINIO_TLS_ACCESS_KEY=minioadmin
MINIO_TLS_SECRET_KEY=minioadmin

# === Proxy : build Docker (npm ci) et appels S3 du backend (laisser vide si aucun) ===
# NO_PROXY vide = localhost,127.0.0.1 cote backend
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
